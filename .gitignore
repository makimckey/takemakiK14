# === Research Lab Policy ===
# 🚫 生体信号ファイルは禁止
*.edf
*.bdf
*.bin
*.rml

# 🚫 音声ファイルは禁止
*.wav
*.mp3
*.m4a
*.flac
*.aac

# 🚫 実験データ形式禁止 (NumPy, MATLAB, SPSS, HDF5)
*.npz
*.npy
*.mat
*.sav
*.h5

# 🚫 大容量Office系（原則アップロード禁止）
*.pptx
*.docx
*.xlsm

# 🚫 画像ファイル（リポジトリ保存禁止）
*.png
*.eps
*.tif
*.tiff
*.svg

# 🚫 機械学習モデルファイル（Pickle/Joblib/PyTorch）
*.pkl
*.pickle
*.joblib
*.pt
*.pth

# === Experiment results (ignored by default) ===
results/
